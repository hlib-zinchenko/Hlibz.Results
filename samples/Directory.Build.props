<Project>

    <Import Project="$([MSBuild]::GetPathOfFileAbove('Directory.Build.props', '$(MSBuildThisFileDirectory)../'))" />

    <!-- Samples are apps, not packages: one target framework, never packed. -->
    <PropertyGroup>
        <TargetFrameworks></TargetFrameworks>
        <TargetFramework>net11.0</TargetFramework>
        <IsPackable>false</IsPackable>
        <GenerateDocumentationFile>false</GenerateDocumentationFile>
    </PropertyGroup>

    <!--
        The error code generator every sample project compiles with, as the Hlibz.Results package
        brings it to your own projects; ErrorCodeCatalog reads the list it writes.
    -->
    <ItemGroup>
        <ProjectReference Include="$(MSBuildThisFileDirectory)../src/Hlibz.Results.Generators/Hlibz.Results.Generators.csproj"
                          OutputItemType="Analyzer"
                          ReferenceOutputAssembly="false" />
    </ItemGroup>

</Project>
