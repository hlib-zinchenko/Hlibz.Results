<Project Sdk="Microsoft.NET.Sdk.Web">

  <!--
    Every build writes the error code catalogs (error-codes.json, error-codes.admin.json) to
    error-codes/, for clients to use without running the API; obj/ when ErrorCodesDirectory isn't
    set. Committed, and CI fails when they're stale.
  -->
  <PropertyGroup>
    <ErrorCodesGenerateFiles>true</ErrorCodesGenerateFiles>
    <ErrorCodesDirectory>error-codes</ErrorCodesDirectory>
  </PropertyGroup>

  <ItemGroup>
    <!-- In your own app: PackageReference Include="Hlibz.Results.AspNetCore". -->
    <ProjectReference Include="..\..\src\Hlibz.Results.AspNetCore\Hlibz.Results.AspNetCore.csproj" />
    <ProjectReference Include="..\Shop.Admin\Shop.Admin.csproj" />
  </ItemGroup>

</Project>
