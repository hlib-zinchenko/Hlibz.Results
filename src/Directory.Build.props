<Project>

    <Import Project="$([MSBuild]::GetPathOfFileAbove('Directory.Build.props', '$(MSBuildThisFileDirectory)../'))" />

    <!--
        Package validation checks the packed assemblies. 3.0 breaks 2.x on purpose (typed errors,
        .NET 11 only), so there's no baseline until 3.0.0 ships; then set it to 3.0.0.
    -->
    <PropertyGroup>
        <EnablePackageValidation>true</EnablePackageValidation>
    </PropertyGroup>

    <ItemGroup>
        <!-- Each package's own README (src/<Package>/README.md) is what its nuget.org page shows. -->
        <None Include="$(MSBuildProjectDirectory)/README.md" Pack="true" PackagePath="\" />
        <None Include="$(MSBuildThisFileDirectory)../docs/icon.png" Pack="true" PackagePath="\" />
    </ItemGroup>

</Project>
