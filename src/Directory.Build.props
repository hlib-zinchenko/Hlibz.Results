<Project>

    <Import Project="$([MSBuild]::GetPathOfFileAbove('Directory.Build.props', '$(MSBuildThisFileDirectory)../'))" />

    <!--
        Package validation checks that the packed assemblies expose the same API on every target
        framework and, against the baseline, that a pack doesn't break the last major release.
    -->
    <PropertyGroup>
        <EnablePackageValidation>true</EnablePackageValidation>
        <PackageValidationBaselineVersion>2.0.0</PackageValidationBaselineVersion>
    </PropertyGroup>

    <ItemGroup>
        <!-- Each package's own README (src/<Package>/README.md) is what its nuget.org page shows. -->
        <None Include="$(MSBuildProjectDirectory)/README.md" Pack="true" PackagePath="\" />
        <None Include="$(MSBuildThisFileDirectory)../docs/icon.png" Pack="true" PackagePath="\" />
    </ItemGroup>

</Project>
