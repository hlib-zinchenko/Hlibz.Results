<Project Sdk="Microsoft.NET.Sdk">

  <!--
      Runs the analyzer and generator on sources compiled in memory, against the reference set of
      the test's own runtime. They are netstandard2.0, so one target framework is enough.
  -->
  <PropertyGroup>
    <TargetFrameworks></TargetFrameworks>
    <TargetFramework>net11.0</TargetFramework>
  </PropertyGroup>

  <ItemGroup>
    <!--
        The Roslyn of the .NET 11.0.100 SDK, not the generator's 4.8 minimum: the tests compile
        C# 15 sources (union declarations) in memory, which 4.8 can't parse.
    -->
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp" VersionOverride="5.12.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Hlibz.Results\Hlibz.Results.csproj" />
    <ProjectReference Include="..\..\src\Hlibz.Results.Generators\Hlibz.Results.Generators.csproj" />
  </ItemGroup>

</Project>
